import numpy as np
import matplotlib.pyplot as plt

# Non-Oscar Winner Movies
non_oscar_movies = [
    "Slumdog Millionaire",
    "Avatar",
    "Inception",
    "Hugo",
    "Lincoln"
]

year = [2008, 2009, 2010, 2011, 2012]

non_oscar_revenue = [378, 2788, 829, 185, 275]  # in $M


# Oscar Winning Movies
oscar_movies = [
    "The Dark Knight",
    "The Hurt Locker",
    "The King's Speech",
    "The Artist",
    "Argo"
]

oscar_revenue = [1005, 170, 427, 133, 232]  # in $M


# X positions
x = np.arange(len(year))
width = 0.4


# Title and labels
plt.title("Oscar and Non-Oscar Movie Revenue")
plt.xlabel("Year")
plt.ylabel("Revenue ($M)")


# Bar charts
plt.bar(
    x - width/2,
    oscar_revenue,
    width,
    color="green",
    label="Oscar Movies"
)

plt.bar(
    x + width/2,
    non_oscar_revenue,
    width,
    label="Non-Oscar Movies"
)


# Show years on X-axis
plt.xticks(x, year)

# Show legend
plt.legend()

# Display chart
plt.show()


