import seaborn as sns
import matplotlib.pyplot as plt



sns.set_theme()


tips=sns.load_dataset("tips")
tips.head()


sns.relplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="smoker",
    size="size",
    style="smoker"
)


#scatter plot


tips=sns.load_dataset("tips")

sns.scatterplot(
    data=tips,
    x="total_bill",
    y="tip",

    hue="time"
)


#line plot
tips=sns.load_dataset("tips")

sns.lineplot(
    data=tips,
    x="total_bill",
    y="tip",

    hue="time"
)


# Bar Plot

tips=sns.load_dataset("tips")
tips.head()

sns.barplot(
    data=tips,
    x="day",
    y="tip",
    hue="sex"
)


# Box Plot

tips=sns.load_dataset("tips")
tips.head()

sns.boxplot(
    data=tips,
    x="day",
    y="tip",
    hue="sex"
)


penguins=sns.load_dataset("penguins")
penguins.head()
sns.histplot(

    data=penguins,
    bins=20,
    x=("body_mass_g")
)



flight=sns.load_dataset("flights")

flight.head()

flight_pivot=flight.pivot(index="month",columns="year" ,values="passengers")

sns.heatmap(
    flight_pivot,
    cmap="coolwarm",
    annot=True,
    fmt="d"
)

plt.title("heatmap")
plt.tight_layout()



